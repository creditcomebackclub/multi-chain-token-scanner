# Required deployment secrets. Do not commit populated files.
DATABASE_URL=
BITQUERY_TOKEN=
COINGECKO_PRO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOPLUS_TOKEN=
HELIUS_API_KEY=
# Set shortlist for free, limited new/trending-pool discovery. Full mode requires Bitquery.
SCAN_MODE=shortlist
INGESTION_ENABLED=true
# Empty values otherwise use safe defaults: all five chains, alerts off, Helius off, Base research only.
CHAINS=
BITQUERY_REQUESTS_PER_MINUTE=6
PUSH_ENABLED=
# Optional informational new-token SCOUT pushes. Off by default; /shortlist still works.
SCOUT_PUSH_ENABLED=false
HELIUS_ENABLED=
HELIUS_PROGRAM_IDS=
BASE_FOMO_CONFIRMED=
# Direct confirmed-swap alerts for the public wallets in config/watched-wallets.json.
WALLET_WATCH_ENABLED=
PORT=
# Local Docker Compose only; choose a password before starting Postgres.
POSTGRES_PASSWORD=

# Rolling 5m scalp watchlist (requires SCAN_MODE=shortlist). A CoinGecko key is optional.
CHART_SETUPS_ENABLED=false
# Research-only assumption for total entry+exit fees, spread and slippage (200 = 2%).
RESEARCH_ROUND_TRIP_COST_BPS=200
# Offline-research collection only. All collectors default off and never alter BUY alerts.
REGIME_CANDLES_ENABLED=false
YOUNG_POOL_RESEARCH_ENABLED=false
EXECUTION_COST_LOGGING_ENABLED=false
# Preregistered execution-cost model assumptions; no wallet or order access.
SHADOW_POSITION_USD=50
FOMO_FEE_BPS_PER_SIDE=100
NETWORK_FEE_USD_SOLANA=0.10
NETWORK_FEE_USD_ETHEREUM=5.00
NETWORK_FEE_USD_BNB=0.20
NETWORK_FEE_USD_ROBINHOOD=0.20
NETWORK_FEE_USD_BASE=0.20
# Informational Telegram research notices. Defaults true and never use alert capacity.
RESEARCH_MILESTONES_ENABLED=true
# ISO-8601 time when the prospective collectors were first enabled. Existing database activation records take precedence.
RESEARCH_COLLECTOR_ACTIVATED_AT=
# Railway Postgres volume limit used only for 80% and 90% warnings.
DB_VOLUME_LIMIT_MB=500
# Default remains 35; allowed range is 1–365 days.
CANDLE_RETENTION_DAYS=35
